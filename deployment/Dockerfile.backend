FROM ghcr.io/astral-sh/uv:0.11.8 AS uv
FROM python:3.12-slim-bookworm AS base
COPY --from=uv /uv /uvx /bin/
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 UV_PYTHON_DOWNLOADS=never
WORKDIR /srv
COPY backend/pyproject.toml backend/uv.lock /srv/backend/
COPY backend/app /srv/backend/app
COPY backend/worker /srv/backend/worker
COPY backend/inference /srv/backend/inference
COPY configs /srv/configs
ENV PATH="/srv/backend/.venv/bin:${PATH}" TRAG_CONFIG=/srv/configs/default.yaml
RUN useradd --system --uid 10001 -m trag && mkdir -p /data /run/trag && chown trag /data /run/trag

FROM base AS api
RUN uv sync --locked --project /srv/backend --no-dev --no-editable
USER trag

FROM base AS worker
# Tokenizer only. Model weights and torch live in the embedding service.
RUN uv sync --locked --project /srv/backend --no-dev --no-editable --extra tokenizer
USER trag

FROM base AS embeddings
RUN uv sync --locked --project /srv/backend --no-dev --no-editable --extra inference
USER trag

FROM base AS parser
RUN apt-get update && apt-get install -y --no-install-recommends       libreoffice-writer fonts-dejavu-core libgl1 libglib2.0-0 tesseract-ocr-rus tesseract-ocr-eng &&     rm -rf /var/lib/apt/lists/* &&     uv sync --locked --project /srv/backend --no-dev --no-editable --extra pdf
USER trag
